    {
        "id": "16c15c56fc94ae04",
        "type": "function",
        "z": "ddd3369c16a022bc",
        "name": "Process Soort Data",
        "func": "// CSV tekst uit bericht halen en opschonen\nvar csvTekst = msg.payload.trim();\nvar gegevens = [];\n\nfunction parseerCSV(tekst) {\n    var regels = [];\n    var huidigeRegel = '';\n    var inAanhalingstekens = false;\n    var i = 0;\n\n    while (i < tekst.length) {\n        var karakter = tekst[i];\n        if (karakter === '\"') {\n            inAanhalingstekens = !inAanhalingstekens;\n            huidigeRegel += karakter;\n        } else if (karakter === '\\n' && !inAanhalingstekens) {\n            if (huidigeRegel.trim()) {\n                regels.push(huidigeRegel.trim());\n            }\n            huidigeRegel = '';\n        } else {\n            huidigeRegel += karakter;\n        }\n        i++;\n    }\n    // Laatste regel toevoegen als deze niet leeg is\n    if (huidigeRegel.trim()) {\n        regels.push(huidigeRegel.trim());\n    }\n    return regels;\n}\n\nfunction parseerCSVRij(rij) {\n    var resultaat = [];\n    var huidig = '';\n    var inAanhalingstekens = false;\n    var i = 0;\n\n    while (i < rij.length) {\n        var karakter = rij[i];\n        if (karakter === '\"') {\n            // Dubbele aanhalingstekens binnen aanhalingstekens = letterlijke aanhalingsteken\n            if (inAanhalingstekens && rij[i + 1] === '\"') {\n                huidig += '\"';\n                i++; // Extra karakter overslaan\n            } else {\n                inAanhalingstekens = !inAanhalingstekens;\n            }\n        } else if (karakter === ',' && !inAanhalingstekens) {\n            // Komma buiten aanhalingstekens = nieuwe kolom\n            resultaat.push(huidig);\n            huidig = '';\n        } else {\n            huidig += karakter;\n        }\n        i++;\n    }\n    // Laatste kolom toevoegen\n    resultaat.push(huidig);\n    return resultaat;\n}\n\ntry {\n    // CSV tekst parsen naar individuele regels\n    var regels = parseerCSV(csvTekst);\n    node.warn('CSV geparseerd naar ' + regels.length + ' regels');\n\n    // Controleren of er voldoende data is (minimaal header + 1 regel)\n    if (regels.length < 2) {\n        return { payload: [], topic: 'geen_data' };\n    }\n\n    // Door alle regels itereren (eerste regel = header, dus vanaf index 1)\n    for (var i = 1; i < regels.length; i++) {\n        var regel = regels[i];\n        if (!regel.trim()) continue; // Lege regels overslaan\n\n        // Regel parsen naar individuele kolommen\n        var kolommen = parseerCSVRij(regel);\n\n        // Controleren of er voldoende kolommen zijn voor een soort\n        if (kolommen.length >= 8) {\n            var soort = {\n                soort: kolommen[0] || 'Onbekend',\n                scientific: kolommen[1] || 'Onbekend',\n                status: kolommen[2] || 'Onbekend',\n                observations: parseInt(kolommen[3]) || 0,\n                lastSeen: kolommen[4] || 'Onbekend',\n                description: kolommen[5] || 'Geen beschrijving',\n                conservation: kolommen[6] || 'Onbekend',\n                image_url: kolommen[7] || 'Geen afbeelding'\n            };\n            gegevens.push(soort);\n        }\n    }\n\n    // Resultaat loggen en terugsturen\n    node.warn('Totaal aantal soorten verwerkt: ' + gegevens.length);\n    return { payload: gegevens, topic: 'soorten_data' };\n\n} catch (fout) {\n    // Foutafhandeling\n    node.error('Fout: ' + fout.message);\n    return { payload: [], topic: 'fout', error: fout.message };\n}",
