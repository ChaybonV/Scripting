        "order": 1,
        "width": 12,
        "height": 12,
        "format": "<style>\n    .nr-dashboard-sjabloon {\n        padding: 0 !important;\n        margin: 0 !important;\n        background: transparent !important;\n        box-shadow: none !important;\n        border: none !important;\n    }\n\n    .nr-dashboard-sjabloon .nr-dashboard-sjabloon-inhoud {\n        padding: 0 !important;\n        margin: 0 !important;\n    }\n\n    .soorten-container {\n        width: 100%;\n        height: 100%;\n        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);\n        border-radius: 15px;\n        overflow: hidden;\n        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\n        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    }\n\n    .soorten-koptekst {\n        margin: 0;\n        padding: 25px;\n        color: white;\n        background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);\n        font-size: 1.4em;\n        font-weight: 600;\n        box-shadow: 0 4px 20px rgba(231, 76, 60, 0.3);\n        text-align: center;\n    }\n\n    .soorten-inhoud {\n        height: calc(100% - 85px);\n        overflow-y: auto;\n        padding: 20px;\n    }\n\n    .soorten-kaart {\n        background: white;\n        margin-bottom: 16px;\n        padding: 24px;\n        border-radius: 12px;\n        border-left: 5px solid #e74c3c;\n        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n        transition: all 0.3s ease;\n        border: 1px solid #f1f3f4;\n    }\n\n    .soorten-kaart:hover {\n        transform: translateY(-2px);\n        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);\n        border-left-color: #c0392b;\n    }\n\n    .soorten-informatie {\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-start;\n        margin-bottom: 16px;\n    }\n\n    .soorten-details {\n        flex: 1;\n        margin-right: 20px;\n    }\n\n    .soorten-naam {\n        font-weight: 700;\n        color: #2c3e50;\n        margin-bottom: 8px;\n        font-size: 1.2em;\n        line-height: 1.3;\n    }\n\n    .soorten-wetenschappelijk {\n        font-style: italic;\n        color: #6c757d;\n        margin-bottom: 12px;\n        font-size: 1em;\n        line-height: 1.4;\n    }\n\n    .soorten-aantal {\n        background: linear-gradient(45deg, #e74c3c, #c0392b);\n        color: white;\n        padding: 10px 16px;\n        border-radius: 25px;\n        font-size: 0.9em;\n        font-weight: 600;\n        white-space: nowrap;\n        box-shadow: 0 3px 12px rgba(231, 76, 60, 0.25);\n    }\n\n    .soorten-datum {\n        color: #868e96;\n        font-size: 0.95em;\n        display: flex;\n        align-items: center;\n        margin-top: 4px;\n    }\n\n    .lege-staat {\n        text-align: center;\n        color: #6c757d;\n        padding: 80px 20px;\n    }\n\n    .lege-tekst {\n        font-family: Arial, sans-serif;\n        font-size: 1.1em;\n        line-height: 1.6;\n        color: #495057;\n    }\n\n    .statistieken-samenvatting {\n        background: white;\n        border-radius: 12px;\n        padding: 20px;\n        margin-bottom: 20px;\n        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n        border-left: 5px solid #3498db;\n    }\n\n    .statistieken-rij {\n        display: flex;\n        justify-content: space-between;\n        margin-bottom: 10px;\n    }\n\n    .statistieken-label {\n        font-weight: 600;\n        color: #2c3e50;\n    }\n\n    .statistieken-waarde {\n        color: #27ae60;\n        font-weight: 700;\n    }\n</style>\n\n<div class=\"soorten-container\">\n    <h4 class=\"soorten-koptekst\">Zeldzame Soorten in de Provincie</h4>\n\n    <div class=\"soorten-inhoud\">\n        <div ng-if=\"msg.payload && msg.payload.length > 0\">\n            <div class=\"statistieken-samenvatting\">\n                <div class=\"statistieken-rij\">\n                    <span class=\"statistieken-label\">Aantal zeldzame soorten:</span>\n                    <span class=\"statistieken-waarde\">{{msg.payload.length}}</span>\n                </div>\n                <div class=\"statistieken-rij\">\n                    <span class=\"statistieken-label\">Minste waarnemingen:</span>\n                    <span class=\"statistieken-waarde\">{{msg.payload[0].aantal}}</span>\n                </div>\n                <div class=\"statistieken-rij\">\n                    <span class=\"statistieken-label\">Meeste waarnemingen (van zeldzame):</span>\n                    <span class=\"statistieken-waarde\">{{msg.payload[msg.payload.length-1].aantal}}</span>\n                </div>\n            </div>\n        </div>\n\n        <div ng-repeat=\"item in msg.payload\" class=\"soorten-kaart\">\n            <div class=\"soorten-informatie\">\n                <div class=\"soorten-details\">\n                    <div class=\"soorten-naam\">{{item.soort}}</div>\n                    <div ng-if=\"item.wetenschappelijk\" class=\"soorten-wetenschappelijk\">{{item.wetenschappelijk}}</div>\n                </div>\n                <div class=\"soorten-aantal\">{{item.aantal}} waarnemingen</div>\n            </div>\n            <div class=\"soorten-datum\">\n                Laatst gezien: {{item.datum}}\n            </div>\n        </div>\n\n        <div ng-if=\"!msg.payload || msg.payload.length === 0\" class=\"lege-staat\">\n            <p class=\"lege-tekst\">Klik op 'Laad Biodiversiteit Data' om de zeldzame soorten te bekijken</p>\n        </div>\n    </div>\n</div>",
