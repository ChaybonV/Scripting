    {
        "id": "5e5bc6a6f352030d",
        "type": "ui_template",
        "z": "ddd3369c16a022bc",
        "group": "b6f97192dcfaab52",
        "name": "Soort Display",
        "order": 1,
        "width": 12,
        "height": 18,
        "format": "<style>\n    .soorten-verkenner {\n        width: 100%;\n        height: 100%;\n        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        border-radius: 20px;\n        overflow: hidden;\n        font-family: 'Segoe UI', sans-serif;\n        color: white;\n        position: relative\n    }\n\n    .verkenner-koptekst {\n        background: rgba(255, 255, 255, 0.1);\n        backdrop-filter: blur(10px);\n        padding: 25px;\n        text-align: center;\n        border-bottom: 1px solid rgba(255, 255, 255, 0.2)\n    }\n\n    .verkenner-titel {\n        font-size: 2.2em;\n        font-weight: 700;\n        margin: 0;\n        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3)\n    }\n\n    .verkenner-ondertitel {\n        font-size: 1em;\n        opacity: 0.8;\n        margin-top: 10px\n    }\n\n    .verkenner-inhoud {\n        padding: 30px;\n        height: calc(100% - 140px);\n        overflow-y: auto\n    }\n\n    .soorten-raster {\n        display: grid;\n        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));\n        gap: 25px\n    }\n\n    .soorten-kaart {\n        background: rgba(255, 255, 255, 0.15);\n        backdrop-filter: blur(10px);\n        border-radius: 15px;\n        padding: 25px;\n        border: 1px solid rgba(255, 255, 255, 0.2);\n        transition: all 0.3s ease\n    }\n\n    .soorten-kaart:hover {\n        background: rgba(255, 255, 255, 0.25);\n        transform: translateY(-5px);\n        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2)\n    }\n\n    .soorten-naam {\n        font-size: 1.4em;\n        font-weight: 700;\n        margin-bottom: 8px;\n        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3)\n    }\n\n    .soorten-wetenschappelijk {\n        font-size: 1em;\n        font-style: italic;\n        opacity: 0.9;\n        margin-bottom: 15px\n    }\n\n    .status-badge {\n        display: inline-block;\n        padding: 6px 15px;\n        border-radius: 20px;\n        font-weight: 600;\n        font-size: 0.8em;\n        text-transform: uppercase;\n        letter-spacing: 0.5px;\n        margin-bottom: 15px;\n        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);\n        background: linear-gradient(45deg, #3498db, #2980b9)\n    }\n\n    .soorten-afbeelding-container {\n        position: relative;\n        width: 100%;\n        height: 150px;\n        border-radius: 10px;\n        margin-bottom: 15px;\n        overflow: hidden;\n        /* Gradient achtergrond voor witte gebieden */\n        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);\n    }\n\n    .soorten-afbeelding {\n        width: 100%;\n        height: 100%;\n        object-fit: cover;\n        border-radius: 10px;\n        transition: transform 0.3s ease, opacity 0.3s ease;\n        /* Fallback gradient voor loading */\n        background: linear-gradient(135deg, rgba(102, 126, 234, 0.5) 0%, rgba(118, 75, 162, 0.5) 100%);\n    }\n\n    .soorten-kaart:hover .soorten-afbeelding {\n        transform: scale(1.05);\n    }\n\n    .soorten-informatie {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 10px;\n        margin-bottom: 15px;\n        font-size: 0.9em\n    }\n\n    .informatie-item {\n        background: rgba(0, 0, 0, 0.2);\n        padding: 8px 12px;\n        border-radius: 8px;\n        text-align: center\n    }\n\n    .informatie-label {\n        font-weight: 600;\n        font-size: 0.8em;\n        opacity: 0.8;\n        margin-bottom: 2px\n    }\n\n    .informatie-waarde {\n        font-weight: 700\n    }\n\n    .beschrijving {\n        background: rgba(0, 0, 0, 0.2);\n        padding: 15px;\n        border-radius: 10px;\n        margin-top: 15px;\n        line-height: 1.4;\n        font-size: 0.9em;\n        max-height: 200px;\n        overflow-y: auto\n    }\n\n    .geen-data {\n        text-align: center;\n        padding: 60px 20px;\n        opacity: 0.8\n    }\n\n    .fout-bericht {\n        background: rgba(231, 76, 60, 0.2);\n        border: 1px solid rgba(231, 76, 60, 0.5);\n        padding: 20px;\n        border-radius: 10px;\n        margin: 20px;\n        text-align: center\n    }\n\n    .statistieken-samenvatting {\n        background: rgba(255, 255, 255, 0.1);\n        backdrop-filter: blur(10px);\n        border-radius: 15px;\n        padding: 20px;\n        margin-bottom: 30px;\n        display: grid;\n        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));\n        gap: 15px\n    }\n\n    .statistiek-item {\n        text-align: center\n    }\n\n    .statistiek-waarde {\n        font-size: 2em;\n        font-weight: 700;\n        color: #f39c12;\n        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3)\n    }\n\n    .statistiek-label {\n        font-size: 0.9em;\n        opacity: 0.9;\n        margin-top: 5px\n    }\n\n    @media (max-width:768px) {\n        .soorten-raster {\n            grid-template-columns: 1fr\n        }\n\n        .soorten-informatie {\n            grid-template-columns: 1fr\n        }\n\n        .statistieken-samenvatting {\n            grid-template-columns: 1fr\n        }\n    }\n</style>\n\n<div class=\"soorten-verkenner\">\n    <div class=\"verkenner-koptekst\">\n        <h1 class=\"verkenner-titel\">Soorten Database</h1>\n        <div class=\"verkenner-ondertitel\">Sprinkhanen & Krekels in Luik</div>\n    </div>\n    <div class=\"verkenner-inhoud\">\n        <div ng-if=\"msg.error\" class=\"fout-bericht\">\n            <h3>Fout bij laden van data</h3>\n            <p>{{msg.error}}</p>\n        </div>\n        <div ng-if=\"msg.payload && msg.payload.length > 0 && !msg.error\">\n            <div class=\"statistieken-samenvatting\">\n                <div class=\"statistiek-item\">\n                    <div class=\"statistiek-waarde\">{{msg.payload.length}}</div>\n                    <div class=\"statistiek-label\">Soorten geladen</div>\n                </div>\n                <div class=\"statistiek-item\">\n                    <div class=\"statistiek-waarde\">{{haalTotaalWaarnemingen()}}</div>\n                    <div class=\"statistiek-label\">Totaal waarnemingen</div>\n                </div>\n            </div>\n            <div class=\"soorten-raster\">\n                <div ng-repeat=\"soort in msg.payload\" class=\"soorten-kaart\">\n                    <div class=\"soorten-naam\">{{soort.soort}}</div>\n                    <div class=\"soorten-wetenschappelijk\">{{soort.scientific}}</div>\n                    <span class=\"status-badge status-{{soort.status.toLowerCase().replace(' ', '-')}}\">{{soort.status}}</span>\n\n                    <div ng-if=\"soort.image_url && soort.image_url !== 'Geen afbeelding'\"\n                        class=\"soorten-afbeelding-container\">\n                        <img ng-src=\"{{soort.image_url}}\"\n                             class=\"soorten-afbeelding\"\n                             alt=\"{{soort.soort}}\"\n                             onerror=\"this.parentElement.innerHTML='<div class=&quot;soorten-afbeelding-placeholder&quot;>🦗</div>'\">\n                    </div>\n\n                    <div class=\"soorten-informatie\">\n                        <div class=\"informatie-item\">\n                            <div class=\"informatie-label\">Waarnemingen</div>\n                            <div class=\"informatie-waarde\">{{soort.observations}}</div>\n                        </div>\n                        <div class=\"informatie-item\">\n                            <div class=\"informatie-label\">Laatste waarneming</div>\n                            <div class=\"informatie-waarde\">{{soort.lastSeen}}</div>\n                        </div>\n                    </div>\n                    <div class=\"beschrijving\">{{soort.description}}</div>\n                </div>\n            </div>\n        </div>\n        <div ng-if=\"(!msg.payload || msg.payload.length === 0) && !msg.error\" class=\"geen-data\">\n            <p>Klik op 'Laad Soorten Data' om de gegevens te bekijken</p>\n        </div>\n    </div>\n</div>\n\n<script>\n    (function(scope) {\n        scope.haalTotaalWaarnemingen = function() {\n            if (!scope.msg || !scope.msg.payload) return 0;\n            return scope.msg.payload.reduce(function(totaal, soort) {\n                return totaal + (soort.observations || 0);\n            }, 0);\n        };\n    })(scope);\n</script>",
