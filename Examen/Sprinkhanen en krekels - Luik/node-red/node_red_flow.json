    {
        "id": "9f46b2fdf9fbc962",
        "type": "function",
        "z": "ddd3369c16a022bc",
        "name": "Process Biodiversity Data",
        "func": "// CSV regels splitsen en lege regels filteren\nvar regels = msg.payload.split('\\n').filter(regel => regel.trim());\nvar gegevens = [];\n\n// Door alle regels itereren (eerste regel = header, dus vanaf index 1)\nfor (var i = 1; i < regels.length; i++) {\n    var kolommen = regels[i].split(';');\n\n    // Controleren of er voldoende kolommen zijn\n    if (kolommen.length >= 3) {\n        // Soortnaam en wetenschappelijke naam splitsen (gescheiden door \" - \")\n        var naamDelen = kolommen[0].split(' - ');\n        var soort = naamDelen[0].trim();\n        var wetenschappelijk = naamDelen[1] ? naamDelen[1].trim() : '';\n        var aantal = parseInt(kolommen[1]) || 0;\n        var datum = kolommen[2].trim();\n\n        // Soortgegevens toevoegen aan de gegevensarray\n        gegevens.push({\n            soort: soort,\n            wetenschappelijk: wetenschappelijk,\n            aantal: aantal,\n            datum: datum\n        });\n    }\n}\n\n// Sorteer voor meest waargenomen soorten (top 10)\nvar gesorteerHoog = gegevens.slice().sort((a, b) => b.aantal - a.aantal);\nvar topSoorten = gesorteerHoog.slice(0, 10);\n\n// Maak grafiek berichten voor de meest waargenomen soorten\nvar grafiekBerichten = [];\nfor (var i = 0; i < topSoorten.length; i++) {\n    grafiekBerichten.push({\n        payload: topSoorten[i].aantal,\n        topic: topSoorten[i].soort\n    });\n}\n\n// Sorteer voor zeldzame soorten (laagste aantallen)\nvar gesorteerLaag = gegevens.slice().sort((a, b) => a.aantal - b.aantal);\nvar zeldzameSoorten = gesorteerLaag.slice(0, 10);\n\n// Verstuur grafiek data voor top soorten\nfor (var j = 0; j < grafiekBerichten.length; j++) {\n    node.send([grafiekBerichten[j], null]);\n}\n\n// Verstuur tabel data voor zeldzame soorten\nreturn [null, { payload: zeldzameSoorten, topic: 'tabel' }];",
